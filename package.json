{
  "name": "protocol-lms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "audit:migration": "node scripts/audit-pb-directus.mjs --env .env.audit --out protocol-directus-audit.md",
    "test:e2e": "node e2e/auth.e2e.mjs && node e2e/flows.e2e.mjs",
    "directus:plan": "node directus/apply.mjs",
    "directus:verify": "node directus/verify.mjs",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "postbuild": "node scripts/check-secrets.mjs --dist",
    "hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@directus/sdk": "^26.0.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/unbounded": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.2",
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "i18next": "^24.2.0",
    "i18next-browser-languagedetector": "^8.0.2",
    "lenis": "^1.3.27",
    "lucide-react": "^0.469.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.64.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
