# PROTOCOL LMS — systemd-юнит для PocketBase.
# Куда класть: /etc/systemd/system/pocketbase.service
# Включить:    systemctl daemon-reload
#              systemctl enable --now pocketbase
# Логи:        journalctl -u pocketbase -f
#
# PocketBase слушает только localhost — наружу его отдаёт nginx по HTTPS.

[Unit]
Description=PocketBase (PROTOCOL LMS)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/pocketbase
ExecStart=/opt/pocketbase/pocketbase serve --http=127.0.0.1:8090
Restart=always
RestartSec=3
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
