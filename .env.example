# Адрес бэкенда Directus. В продакшене — внешний адрес, не локалхост.
VITE_DIRECTUS_URL=http://127.0.0.1:8055

# DEV-токен (только для локальной разработки, НЕ задавать в проде)
# VITE_DIRECTUS_STATIC_TOKEN=
# Вход без проверки пароля — только вместе с токеном и только в dev (true включает)
# VITE_DEV_AUTH_BYPASS=

# Старый бэкенд PocketBase (если ещё используется)
# VITE_POCKETBASE_URL=http://127.0.0.1:8090